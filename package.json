  "dependencies": {
    "@ant-design/icons": "^6.2.2",
    "@tanstack/react-query": "^5.100.9",
    "antd": "^6.3.7",
    "axios": "^1.16.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.20",
    "echarts": "^6.0.0",
    "lightweight-charts": "^5.2.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.15.0",
    "zustand": "^5.0.13"
