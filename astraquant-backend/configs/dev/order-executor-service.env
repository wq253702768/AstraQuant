SERVICE_NAME=order-executor-service
ENV=dev
HTTP_PORT=8018
POSTGRES_DSN=postgres://astra:astra_password@localhost:5432/astraquant?sslmode=disable
REDIS_ADDR=localhost:6379
NATS_URL=nats://localhost:4222
OKX_PRIVATE_GATEWAY_URL=http://localhost:8017
EXCHANGE_ACCOUNT_SERVICE_URL=http://localhost:8016
RISK_ENGINE_URL=http://localhost:8013
SIGNAL_ENGINE_URL=http://localhost:8009
PAPER_MONITOR_SERVICE_URL=http://localhost:8015
LIVE_TRADING_ENABLED=false
ORDER_EXECUTION_MODE=DRY_RUN
LIVE_SMALL_MAX_ORDER_NOTIONAL_PCT=0.05
LIVE_SMALL_MAX_STRATEGY_NOTIONAL_PCT=0.10
LIVE_SMALL_MAX_LEVERAGE=2
LIVE_SMALL_MAX_DAILY_ORDER_COUNT=10
ORDER_SUBMIT_TIMEOUT_MS=3000
ORDER_ACK_TIMEOUT_SECONDS=3
ORDER_RECONCILE_INTERVAL_SECONDS=5
UNKNOWN_ORDER_MAX_RETRY=10
CLIENT_ORDER_ID_PREFIX=AQ
OKX_ORDER_TAG=ASTRA
LOG_LEVEL=INFO
