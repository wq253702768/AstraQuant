SERVICE_NAME=signal-engine
ENV=dev
HTTP_PORT=8009
DATABASE_URL=postgresql+asyncpg://astra:astra_password@localhost:5432/astraquant
REDIS_URL=redis://localhost:6379/0
NATS_URL=nats://localhost:4222
STRATEGY_SERVICE_URL=http://localhost:8002
STRATEGY_SCORE_SERVICE_URL=http://localhost:8007
REALTIME_STATE_SERVICE_URL=http://localhost:8012
DEFAULT_EXCHANGE=OKX
DEFAULT_SYMBOLS=BTC-USDT-SWAP,ETH-USDT-SWAP
DEFAULT_TIMEFRAMES=1m,5m
RUNTIME_MODE=HYBRID
STATE_POLL_INTERVAL_MS=1000
SIGNAL_COOLDOWN_SECONDS=300
MAX_SPREAD_PCT=0.001
MAX_ABS_FUNDING_RATE=0.0005
LOG_LEVEL=INFO
