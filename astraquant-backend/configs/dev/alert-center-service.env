SERVICE_NAME=alert-center-service
ENV=dev
HTTP_PORT=8021
DATABASE_URL=postgresql+asyncpg://astra:astra_password@localhost:5432/astraquant
REDIS_URL=redis://localhost:6379/0
NATS_URL=nats://localhost:4222
DEFAULT_DEDUP_WINDOW_SECONDS=300
DEFAULT_SUPPRESSION_ENABLED=true
DEFAULT_ESCALATION_ENABLED=true
WEBHOOK_ENABLED=true
WEBHOOK_DEFAULT_URL=http://localhost:9000/mock-alert-webhook
EMAIL_ENABLED=false
LOG_LEVEL=INFO
