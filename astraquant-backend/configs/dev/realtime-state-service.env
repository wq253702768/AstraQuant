SERVICE_NAME=realtime-state-service
ENV=dev
HTTP_PORT=8012
NATS_URL=nats://localhost:4222
REDIS_ADDR=localhost:6379
REDIS_DB=0
DEFAULT_EXCHANGE=OKX
DEFAULT_SYMBOLS=BTC-USDT-SWAP,ETH-USDT-SWAP
DEFAULT_TIMEFRAMES=1m,5m
TICKER_STALE_MS=5000
BBO_STALE_MS=3000
TRADE_STALE_MS=10000
MARK_PRICE_STALE_MS=5000
FUNDING_STALE_MS=60000
REDIS_WRITE_ENABLED=true
WS_PUSH_ENABLED=true
SSE_PUSH_ENABLED=true
LOG_LEVEL=INFO
