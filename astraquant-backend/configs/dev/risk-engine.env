SERVICE_NAME=risk-engine
ENV=dev
HTTP_PORT=8013
POSTGRES_DSN=postgres://astra:astra_password@localhost:5432/astraquant?sslmode=disable
REDIS_ADDR=localhost:6379
NATS_URL=nats://localhost:4222
REALTIME_STATE_SERVICE_URL=http://localhost:8012
STRATEGY_SERVICE_URL=http://localhost:8002
SIGNAL_ENGINE_URL=http://localhost:8009
DEFAULT_EXCHANGE=OKX
DEFAULT_SYMBOLS=BTC-USDT-SWAP,ETH-USDT-SWAP
RULE_VERSION=v1.0
MAX_SPREAD_PCT=0.001
MAX_ABS_FUNDING_RATE=0.0005
DEFAULT_MAX_LEVERAGE=3
DEFAULT_MAX_POSITION_PCT=0.2
DEFAULT_MAX_SINGLE_TRADE_LOSS_PCT=0.005
DEFAULT_MAX_DAILY_LOSS_PCT=0.02
DEFAULT_MAX_CONSECUTIVE_LOSSES=3
DEFAULT_MAX_STRATEGY_DRAWDOWN_PCT=0.06
DEFAULT_OPEN_COOLDOWN_SECONDS=300
LOG_LEVEL=INFO
