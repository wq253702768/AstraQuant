SERVICE_NAME=paper-monitor-service
ENV=dev
HTTP_PORT=8015
DATABASE_URL=postgresql+asyncpg://astra:astra_password@localhost:5432/astraquant
REDIS_URL=redis://localhost:6379/0
NATS_URL=nats://localhost:4222
PAPER_TRADING_SERVICE_URL=http://localhost:8014
RISK_ENGINE_URL=http://localhost:8013
SIGNAL_ENGINE_URL=http://localhost:8009
STRATEGY_SCORE_SERVICE_URL=http://localhost:8007
REPORT_SERVICE_URL=http://localhost:8008
DEFAULT_MIN_OBSERVATION_DAYS=7
DEFAULT_MIN_TRADE_COUNT=20
DEFAULT_MAX_DRAWDOWN_PCT=0.05
DEFAULT_MAX_CONSECUTIVE_LOSSES=3
DEFAULT_MAX_COST_TO_PROFIT_RATIO=0.25
DEFAULT_MAX_DATA_STALE_COUNT=10
DEFAULT_MAX_ORDER_ERROR_COUNT=0
DAILY_SUMMARY_CRON=10 0 * * *
LOG_LEVEL=INFO
