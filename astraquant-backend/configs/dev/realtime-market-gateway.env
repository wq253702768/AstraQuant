SERVICE_NAME=realtime-market-gateway
ENV=dev
HTTP_PORT=8011
NATS_URL=nats://localhost:4222
REDIS_ADDR=localhost:6379
OKX_PUBLIC_WS_URL=wss://ws.okx.com:8443/ws/v5/public
OKX_BUSINESS_WS_URL=wss://ws.okx.com:8443/ws/v5/business
EXCHANGE_GATEWAY_URL=http://localhost:8010
WS_PING_INTERVAL_SECONDS=20
WS_PONG_TIMEOUT_SECONDS=10
WS_RECONNECT_MAX_BACKOFF_SECONDS=30
FUNDING_POLL_ENABLED=true
FUNDING_POLL_INTERVAL_SECONDS=30
DEFAULT_SYMBOLS=BTC-USDT-SWAP,ETH-USDT-SWAP
DEFAULT_TIMEFRAMES=1m,5m
LOG_LEVEL=INFO
