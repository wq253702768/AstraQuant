# AstraQuant staging environment template.
# Copy this file to /opt/astraquant/env/.env.staging on the server and fill real values there.
# Never commit real secrets.

ASTRA_ENV=staging
ASTRA_DOMAIN=
ASTRA_PUBLIC_BASE_URL=http://47.239.90.234:8000

POSTGRES_USER=astra
POSTGRES_PASSWORD=change_me_on_server
POSTGRES_DB=astraquant
DATABASE_URL=postgresql+asyncpg://astra:change_me_on_server@postgres:5432/astraquant
POSTGRES_DSN=postgres://astra:change_me_on_server@postgres:5432/astraquant?sslmode=disable

REDIS_URL=redis://redis:6379/0
REDIS_ADDR=redis:6379
NATS_URL=nats://nats:4222

JWT_SECRET=change_me_to_long_random_secret
LOCAL_MASTER_KEY=change_me_32_bytes_minimum_for_staging

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change_me_on_server
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=change_me_on_server
MINIO_SECURE=false

LOG_LEVEL=INFO
API_GATEWAY_PORT=8000
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://47.239.90.234:8000

# Trading defaults. Keep live trading disabled unless explicitly approved.
LIVE_TRADING_ENABLED=false
ORDER_EXECUTION_MODE=DRY_RUN

